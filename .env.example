# support-service — deployment env template (deploy@solo.harmonicr.com).
# Copy to deploy .env and fill real values. NEVER commit real secrets.
# Values are read server-side from .env only (never echoed, never committed).

# Postgres (dedicated support-postgres, no reuse)
DB_USERNAME=support
DB_PASSWORD=            # REQUIRED, generate a strong value
DB_HOST=support-postgres
DB_PORT=5432
DB_NAME=support

# Create endpoint shared secret (C-2). event-triage sends this as X-API-Key.
CREATE_API_KEY=        # REQUIRED, shared with event-triage PeppermintKey

# llmesh AI gateway (S-1: team key + RBAC allow policy on triage model)
LLMESH_URL=https://llm.harmonicr.com
LLMESH_KEY=            # REQUIRED, team key scoped by RBAC allow policy
LLMESH_MODEL=triage-fast # env default; runtime-overridable via /admin UI
AI_ENABLED=true        # master AI toggle (env default; overridable via /admin)
TICKET_LIST_LIMIT=50   # dashboard list limit (env default; overridable via /admin)

# Zitadel OIDC (app "support")
OIDC_ISSUER=https://auth.harmonicr.com
OIDC_CLIENT_ID=        # REQUIRED
OIDC_CLIENT_SECRET=    # REQUIRED
OIDC_REDIRECT_URL=https://support.harmonicr.com/callback
# S-5: Zitadel host IP (resolves auth.harmonicr.com inside the container).
OIDC_HOST_IP=10.89.2.189

# Session cookie HMAC key
SESSION_SECRET=        # REQUIRED

# Listen addresses
API_LISTEN_ADDR=:5003
UI_LISTEN_ADDR=:3000
